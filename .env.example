# ============================================
#  Romeo Mamu — কনফিগারেশন (নমুনা)
#  ব্যবহার:  cp .env.example .env   তারপর মানগুলো ভরো
#  (# দিয়ে শুরু হওয়া লাইন কাজ করে না)
# ============================================

# --- তোমার WhatsApp নাম্বার (দেশের কোড সহ, কোনো + বা স্পেস নেই) ---
# যেমন: 919876543210   (ভারত = 91)
BOT_NUMBER=919876543210

# --- তোমার নাম্বার (owner) — শুধু তুমি !status দেখতে পারবে ---
OWNER_NUMBER=919876543210

# --- কী লিখলে Romeo সাড়া দেবে (কমা দিয়ে আলাদা করো) ---
# "@Romeo" / "Romeo" / "Romeo mama" / "রোমিও" / "মামা" — সব চলবে
# WhatsApp-এ @ দিয়ে মেনশন করলে সেটা আলাদাভাবে ধরা হয়, এখানে লিখতে হবে না
TRIGGER_WORDS=romeo,রোমিও,rome,romo,romio,rmio,রমিও,রমিয়ো,mama,মামা,mamu,মামু,mamuji,মামুজি,romeo mama,রোমিও মামা,janu,জানু,jaanu,jaan,জান,sona,সোনা,shona,babu,বাবু,baby,বেবি,bondhu,বন্ধু,dost,দোস্ত,bhai,ভাই,vai,bro,দাদা,dada,pagla,পাগলা,ostad,ওস্তাদ,guru,গুরু,boss,বস,raja,রাজা

# --- 🤖 Gemini API key (AI ব্রেন) ---
# কোথায় পাবে: https://aistudio.google.com/apikey   (ফ্রি, কোনো কার্ড লাগবে না)
GEMINI_API_KEY=

# --- ঐচ্ছিক ব্যাকআপ brain (না থাকলে খালি রাখো, কোনো সমস্যা নেই) ---
GROQ_API_KEY=

# --- AI সীমা ---
AI_DAILY_CAP=300
CONTEXT_SIZE=30

# 💬 একবার কথা শুরু করলে কত মিনিট নাম ছাড়াই উত্তর দেবে
CONVO_TIMEOUT_MIN=10

# --- মডেল (সাধারণত বদলাতে হবে না) ---
GEMINI_MODEL=gemini-flash-lite-latest

# --- বট কোন গ্রুপে কাজ করবে (group ID) ---
# 🌍 true = Romeo যেই গ্রুপেই থাকবে সবখানেই কাজ করবে (ID খোঁজার দরকার নেই)
#    false = শুধু নিচের ALLOWED_GROUPS-এ থাকা গ্রুপগুলোতে
ALLOW_ALL_GROUPS=true
ALLOWED_GROUPS=

# --- রেট লিমিট (AI কোটা বাঁচাতে) ---
COOLDOWN_MS=4000
DAILY_CAP_PER_USER=120

# --- নিজে থেকে কতবার কথা বলবে (শতাংশে: 0-100) ---
# 0 = শুধু ডাকলে কথা বলবে | 8 = মাঝে মাঝে নিজে থেকে মন্তব্য
AUTO_CHAT_CHANCE=0

# --- বট কি মেসেজ "পড়েছে" দেখাবে? (false = তোমার নীল টিক অক্ষত থাকবে) ---
SEND_READ_RECEIPTS=false

# --- "typing..." দেখাবে? (মনে হবে মানুষ টাইপ করছে) ---
TYPING_INDICATOR=true

# --- ডিবাগ লগ (সমস্যা হলে true করো) ---
DEBUG=false

# --- বিরক্ত না করা ---
# BUTT_IN=false  → গ্রুপে দুজন নিজেদের মধ্যে কথা বললে Romeo চুপ থাকবে (ডিফল্ট, সবার আরাম)
# BUTT_IN=true   → Romeo সব মেসেজেই ঢুকে জবাব দেবে (উদ্ধত)
BUTT_IN=false
# Romeo এক কথায় সর্বোচ্চ কতবার নিজে থেকে উত্তর দেবে — এরপর নাম দিয়ে ডাকতে হবে
MAX_CONVO_TURNS=4
# Romeo-এর উত্তর কত বড় হবে (অক্ষরে)। ছোট চাইলে 150 বা 120 দাও, বড় চাইলে 300
REPLY_MAX_CHARS=160
# 🎵 গান: দিনে সর্বোচ্চ কতটা (নাম্বার বাঁচাতে), আর এক গানের সর্বোচ্চ সাইজ (MB)
SONG_DAILY_CAP=15
SONG_MAX_MB=15
# গান না এলে কোথায় আটকাচ্ছে গ্রুপেই দেখাবে (খোঁজার জন্য) — ঠিক হয়ে গেলে false করে দিও
SONG_DEBUG=true

# ==========================================================
#  ☁️ ক্লাউডে চালালে (Render) — ফোনে চালালে এগুলো লাগবে না
#  বিস্তারিত: CLOUD-SETUP.md
# ==========================================================

# MongoDB-র ঠিকানা। এটা দিলে WhatsApp লগইন সেখানে সেভ হবে,
# সার্ভার রিস্টার্ট হলেও আর পেয়ারিং করতে হবে না।
MONGODB_URI=

# কোন ডেটাবেস (না দিলে romeo)
MONGODB_DB=romeo

# একই MongoDB-তে একাধিক বট চালালে আলাদা নাম দাও
SESSION_ID=default

# Render এই পোর্টেই ঢুঁ মারে। ফোনে চালালে খালি রাখো।
PORT=
